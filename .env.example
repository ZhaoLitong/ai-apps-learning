# ── LLM provider (any OpenAI-compatible API works) ──────────────────────────
# The whole app talks to ONE OpenAI-compatible endpoint for chat + embeddings.
#
#   OpenAI:    just set the key (default endpoint)
#   Zhipu GLM: OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#              AI_CHAT_MODEL=glm-4.6, AI_EMBEDDING_MODEL=embedding-3, EMBEDDING_DIMENSIONS=2048
#   DeepSeek:  OPENAI_BASE_URL=https://api.deepseek.com  (chat only — no embeddings API,
#              so pair it with another provider for AI_EMBEDDING_MODEL)
#   Ollama:    OPENAI_BASE_URL=http://localhost:11434/v1 (e.g. AI_CHAT_MODEL=qwen2.5:7b,
#              AI_EMBEDDING_MODEL=nomic-embed-text, EMBEDDING_DIMENSIONS=768)
OPENAI_API_KEY=
# Optional: overrides https://api.openai.com/v1 when set
OPENAI_BASE_URL=

# ── Models ──────────────────────────────────────────────────────────────────
AI_CHAT_MODEL=gpt-4o-mini
# Used for memory extraction + eval judging — a cheaper model is fine here
AI_SMALL_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# MUST match your embedding model's output size AND the `chunks.embedding`
# column (see src/db/schema.ts). If you change it: run `npm run db:push`
# again, then `npm run db:seed` to re-embed everything.
EMBEDDING_DIMENSIONS=1536

# ── Postgres (matches docker-compose.yml — host port 5433) ──────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ai_learning
